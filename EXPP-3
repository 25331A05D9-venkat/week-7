#include <stdio.h>
#include <string.h>
 
int main() {
char s1[100], s2[50];
int i = 0, j = 0;
printf("25331A05D9\n");
printf("Enter first string: ");
fgets(s1,sizeof(s1),stdin);
s1[strcspn(s1, "\n")] = '\0';
printf("Enter second string: ");
fgets(s2,sizeof(s2),stdin);
s2[strcspn(s2, "\n")] = '\0';
while (s1[i] != '\0') i++;
s1[i++] = ' ';
while (s2[j] != '\0')
s1[i++] = s2[j++];
s1[i] = '\0';
printf("Concatenated: %s\n", s1);
return 0;
}
